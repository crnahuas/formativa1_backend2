{
  "info": {
    "name": "MINIMARKET PLUS - Seguridad",
    "description": "Pruebas de autenticacion y autorizacion para MINIMARKET PLUS con Java 21 y Spring Boot 4.0.6.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Publico - Hola",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/public/hola"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Respuesta contiene Hola Mundo', function () {",
              "  pm.expect(pm.response.text()).to.include('Hola Mundo');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Protegido sin autenticacion - Productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401 Unauthorized', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Cliente - Consulta productos",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "cliente",
              "type": "string"
            },
            {
              "key": "password",
              "value": "cliente123",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Respuesta JSON es lista', function () {",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
